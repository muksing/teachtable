rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. ฟังก์ชันช่วยเช็คสิทธิ์ (ปรับให้ Error-free)
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuth() && (
        getUserData().globalRole == 'superadmin' ||
        getUserData().role == 'superadmin' ||
        ('roles' in getUserData() && getUserData().roles is list && 'superadmin' in getUserData().roles)
      );
    }

    function isSchoolAdmin() {
      return isAuth() && (
        getUserData().role == 'school_admin' ||
        getUserData().role == 'admin' ||
        ('roles' in getUserData() && getUserData().roles is list && (
          'school_admin' in getUserData().roles ||
          'admin' in getUserData().roles
        ))
      );
    }

    function isSchedulerActor() {
      return isAuth() && (
        getUserData().role in ['school_admin', 'admin', 'school_scheduler', 'scheduler', 'superadmin'] ||
        ('roles' in getUserData() && getUserData().roles is list && (
          'school_admin' in getUserData().roles ||
          'admin' in getUserData().roles ||
          'school_scheduler' in getUserData().roles ||
          'scheduler' in getUserData().roles ||
          'superadmin' in getUserData().roles
        ))
      );
    }

    function isSameSchool(schoolId) {
      return isAuth() && (
        getUserData().schoolId == schoolId ||
        getUserData().school_id == schoolId
      );
    }

    function currentDataInOwnSchool() {
      return (
        resource.data.schoolId == getUserData().schoolId ||
        resource.data.school_id == getUserData().schoolId ||
        resource.data.schoolId == getUserData().school_id ||
        resource.data.school_id == getUserData().school_id
      );
    }

    function createInOwnSchool() {
      return (
        request.resource.data.schoolId == getUserData().schoolId ||
        request.resource.data.school_id == getUserData().schoolId ||
        request.resource.data.schoolId == getUserData().school_id ||
        request.resource.data.school_id == getUserData().school_id
      );
    }

    function isTimetableUnlocked(schoolId) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/school_info/main)
        || get(/databases/$(database)/documents/schools/$(schoolId)/school_info/main).data.timetable_locked != true;
    }

    function isScheduleCollection(collectionId) {
      return collectionId in ['assignments', 'timetable_grid', 'activity_booking', 'activity_supervision'];
    }

    function currentDataHasNoSchool() {
      return (
        !('schoolId' in resource.data) &&
        !('school_id' in resource.data)
      );
    }

    function updatesRestrictedSchoolInfoFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pricing_plan',
        'scheduler_limit_override',
        'limit_source',
        'feature_flags'
      ]);
    }

    // 2. เปิดให้สมัครโรงเรียนใหม่ได้จากหน้า public
    match /school_requests/{requestId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.schoolName is string
                    && request.resource.data.schoolName.size() > 0
                    && request.resource.data.contactEmail is string
                    && request.resource.data.adminEmail is string;
      allow read, update: if isSuperAdmin();
    }

    match /renewal_requests/{requestId} {
      allow create: if isAuth()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.school_id is string
                    && request.resource.data.school_id.size() > 0
                    && (request.resource.data.school_id == getUserData().schoolId
                        || request.resource.data.school_id == getUserData().school_id);
      allow read: if isSuperAdmin()
                  || (isAuth()
                      && (resource.data.school_id == getUserData().schoolId
                          || resource.data.school_id == getUserData().school_id));
      allow update: if isSuperAdmin();
    }

    // 3. กฎสำหรับจัดการโรงเรียน (แยกตาม Path ที่เราคุยกัน)
    match /schools/{schoolId} {
      // ตรวจสอบว่า schoolId ใน Path ตรงกับที่ระบุใน User Profile หรือไม่
      allow read: if isSameSchool(schoolId) || isSuperAdmin();
      allow update: if isSameSchool(schoolId) || isSuperAdmin();

      match /school_info/main {
        allow read: if isSameSchool(schoolId) || isSuperAdmin();
        allow write: if isSuperAdmin()
                     || (isSameSchool(schoolId)
                         && isSchoolAdmin()
                         && !updatesRestrictedSchoolInfoFields());
      }

      match /scheduler_presence/{uid} {
        allow read: if isSameSchool(schoolId) || isSuperAdmin();
        allow create, update: if isSameSchool(schoolId)
                              && request.auth.uid == uid
                              && isSchedulerActor();
        allow delete: if (isSameSchool(schoolId) && request.auth.uid == uid) || isSuperAdmin();
      }
      
      // กฎสำหรับ Sub-collections ภายใน (Terms, Students, Schedules)
      match /terms/{termId}/{collectionId}/{docId} {
        allow read: if isSameSchool(schoolId) || isSuperAdmin();
        allow write: if isSuperAdmin()
                     || (isSameSchool(schoolId)
                         && (!isScheduleCollection(collectionId)
                             || isTimetableUnlocked(schoolId)));
      }

      match /terms/{termId}/{document=**} {
        allow read: if isSameSchool(schoolId) || isSuperAdmin();
        allow write: if isSuperAdmin()
                     || (isSameSchool(schoolId) && isTimetableUnlocked(schoolId));
      }

      // รองรับ school_info และ sub-collections อื่นๆ ใต้โรงเรียน
      match /{document=**} {
        allow read, write: if isSameSchool(schoolId) || isSuperAdmin();
      }
    }

    // 4. กฎสำหรับข้อมูลผู้ใช้ (เจ้าตัวอ่าน/เขียนได้เอง)
    match /users/{userId} {
      allow read: if (isAuth() && request.auth.uid == userId)
                  || isSuperAdmin()
            || (isSchoolAdmin() && currentDataInOwnSchool());

      allow create: if isSuperAdmin()
                    || (isSchoolAdmin()
                        && createInOwnSchool()
                        && !('globalRole' in request.resource.data));

      allow update: if isSuperAdmin()
                    || (isSchoolAdmin()
              && (currentDataInOwnSchool() || currentDataHasNoSchool())
                        && (!('schoolId' in request.resource.data) || createInOwnSchool())
                        && !('globalRole' in request.resource.data));

      allow delete: if isSuperAdmin()
            || (isSchoolAdmin() && currentDataInOwnSchool());
    }

    // 5. Email queue ถูกสร้างโดยผู้ใช้ที่ login แล้ว และอ่านได้โดย superadmin
    match /email_queue/{docId} {
      allow create: if isAuth();
      allow read, update: if isSuperAdmin();
    }

    match /plan_change_logs/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /package_catalog/{packageId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /system_config/{docId} {
      allow read: if isSuperAdmin() || (isAuth() && docId == 'pricing_formula');
      allow write: if isSuperAdmin() && docId == 'pricing_formula';
    }
    
    // 6. (ทางเลือก) กฎสำหรับ Admin กลาง (ถ้ามี)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}