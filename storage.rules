rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // School logo — admin can read/write
    match /school_logo/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Published timetable JSON (public reads, authenticated publish writes)
    match /public_timetables/{schoolId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default — deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
